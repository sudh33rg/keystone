{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keystone.local/okf/profiles/repository-intelligence/v2",
  "title": "Keystone Repository Intelligence OKF Profile",
  "version": "2.0.0",
  "format": "keystone-okf",
  "formatVersion": 2,
  "recordClasses": ["unit", "relationship", "observation", "evidence"],
  "knowledgeKinds": [
    "repository",
    "workspace",
    "file",
    "module",
    "package",
    "service",
    "symbol",
    "api",
    "data-entity",
    "configuration",
    "test",
    "documentation",
    "call-flow",
    "data-flow",
    "architecture-boundary",
    "risk-area",
    "change-impact"
  ],
  "relationshipKinds": [
    "contains",
    "defines",
    "imports",
    "depends-on",
    "calls",
    "reads",
    "writes",
    "exposes",
    "implements",
    "extends",
    "tests",
    "covers",
    "configured-by",
    "documented-by",
    "flows-to",
    "may-impact"
  ],
  "confidenceLevels": ["observed", "derived", "inferred"],
  "lifecycleValues": ["active", "deprecated", "deleted"],
  "requiredFields": {
    "unit": [
      "id",
      "profile",
      "profileVersion",
      "kind",
      "name",
      "canonicalKey",
      "properties",
      "confidence",
      "provenance",
      "lifecycle",
      "firstSeenAt",
      "lastSeenAt",
      "createdAt",
      "updatedAt"
    ],
    "relationship": [
      "id",
      "profile",
      "profileVersion",
      "kind",
      "sourceId",
      "targetId",
      "properties",
      "confidence",
      "provenance",
      "lifecycle",
      "firstSeenAt",
      "lastSeenAt",
      "createdAt",
      "updatedAt"
    ],
    "observation": [
      "id",
      "profile",
      "profileVersion",
      "subjectId",
      "predicate",
      "valueType",
      "confidence",
      "provenance",
      "observedAt"
    ],
    "evidence": [
      "id",
      "extractor",
      "extractorVersion",
      "extractionRunId",
      "method",
      "source",
      "observedAt",
      "freshness"
    ]
  },
  "manifestRequiredFields": [
    "format",
    "formatVersion",
    "profile",
    "profileVersion",
    "profileDigest",
    "workspaceId",
    "generatedAt",
    "extractionRunId",
    "validation",
    "projections",
    "counts",
    "digests"
  ],
  "relationshipConstraints": {
    "contains": {
      "sources": ["workspace", "repository", "module", "service", "architecture-boundary"],
      "targets": ["*"]
    },
    "defines": {
      "sources": ["file", "test", "documentation", "configuration", "module", "service"],
      "targets": ["symbol", "api", "data-entity", "service", "call-flow", "data-flow"]
    },
    "imports": {
      "sources": ["file", "test", "module"],
      "targets": ["file", "test", "module", "package"]
    },
    "depends-on": { "sources": ["*"], "targets": ["*"] },
    "calls": {
      "sources": ["symbol", "api", "call-flow"],
      "targets": ["symbol", "api", "service", "call-flow"]
    },
    "reads": {
      "sources": ["symbol", "api", "service", "data-flow"],
      "targets": ["data-entity", "configuration", "file"]
    },
    "writes": {
      "sources": ["symbol", "api", "service", "data-flow"],
      "targets": ["data-entity", "configuration", "file"]
    },
    "exposes": { "sources": ["file", "service", "module"], "targets": ["api"] },
    "implements": {
      "sources": ["symbol", "service"],
      "targets": ["symbol", "architecture-boundary"]
    },
    "extends": { "sources": ["symbol"], "targets": ["symbol"] },
    "tests": { "sources": ["test"], "targets": ["file", "symbol", "api", "service"] },
    "covers": { "sources": ["test"], "targets": ["file", "symbol", "api", "service"] },
    "configured-by": { "sources": ["*"], "targets": ["configuration"] },
    "documented-by": { "sources": ["*"], "targets": ["documentation"] },
    "flows-to": {
      "sources": ["call-flow", "data-flow", "api", "service", "symbol", "file", "data-entity"],
      "targets": ["*"]
    },
    "may-impact": {
      "sources": ["change-impact", "risk-area", "file", "symbol", "service"],
      "targets": ["*"]
    }
  },
  "persistence": {
    "authoritativeRoot": ".keystone/intelligence/okf",
    "atomicCandidatePromotion": true,
    "parentSnapshotLineage": true,
    "derivedProjections": ["graph", "search", "cpg-bindings"]
  }
}
