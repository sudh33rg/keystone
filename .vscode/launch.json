{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Keystone Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--new-window",
        // "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: compile",
      "sourceMaps": true
    }
  ]
}
